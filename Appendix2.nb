Cell[TextData[{
 "1. (x\[CloseCurlyQuote], y\[CloseCurlyQuote], z\[CloseCurlyQuote]) are \
represented by (x3, y3, z3).\n2. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xxx", "c"], TraditionalForm]],ExpressionUUID->
  "02124775-478f-4360-970e-2edd18663ea9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xxy", "c"], TraditionalForm]],ExpressionUUID->
  "281cd5c3-30ec-4f0e-8fb4-36bcd74de49e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xxz", "c"], TraditionalForm]],ExpressionUUID->
  "3da68cf9-9aa8-4eba-9129-4c0da40f2539"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yyx", "c"], TraditionalForm]],ExpressionUUID->
  "99898753-63f3-44f6-a900-797f770e2134"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yyy", "c"], TraditionalForm]],ExpressionUUID->
  "e917b027-7733-4859-9947-deb2244f0cca"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yyz", "c"], TraditionalForm]],ExpressionUUID->
  "7027b408-2c8a-4e66-8a25-d85bf8dd6866"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzx", "c"], TraditionalForm]],ExpressionUUID->
  "6301b95b-d6be-43be-9153-41c423008e2c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzy", "c"], TraditionalForm]],ExpressionUUID->
  "a7d3751b-9df1-4c92-bac4-6e518ae6204d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzz", "c"], TraditionalForm]],ExpressionUUID->
  "a3e743f2-09e3-4bea-919a-63fe7d69e7e1"],
 " in Table 3 and Eqs. (23-25)  are represented by CartesianVxxx, \
CartesianVxxy, CartesianVxxz, CartesianVyyx, CartesianVyyy, CartesianVyyz, \
CartesianVzzx, CartesianVzzy, and CartesianVzzz.\n3. The integral kernels are \
considered and the complete expressions should be presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G\[Rho]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[Lambda]", "1"], 
      SubscriptBox["\[Lambda]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[CurlyPhi]", "1"], 
       SubscriptBox["\[CurlyPhi]", "2"]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["u", "1"], 
        SubscriptBox["u", "2"]], 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", "Kernel", ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"u", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[CurlyPhi]", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[Lambda]", "'"}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9a206267-8617-4de5-a044-01368a100555"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9035606025437403`*^9, 3.903560667511909*^9}, {
