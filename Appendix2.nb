ad749b00b612"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.90356180725404*^9, {3.999588393221627*^9, 3.999588393223022*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"68a4d28e-3341-4a07-a75b-dcb4f462cbaa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"x", "-", "x3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]y", "=", 
   RowBox[{"y", "-", "y3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]z", "=", 
   RowBox[{"z", "-", "z3"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.903561814716457*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"a2a41e8e-de26-479d-b9a9-af841bf1c752"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "*", "\[CapitalDelta]x"}], 
    "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dy", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "-", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dz", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.904073957103447*^9, 3.904073961411117*^9}, {
  3.999588393224156*^9, 3.999588393227434*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"03f2cecc-eae7-46d5-88e7-518ea8e92534"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"FullSimplify", "[", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["dx", "2"], "+", 
      SuperscriptBox["dy", "2"], "+", 
      SuperscriptBox["dz", "2"]}]], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.903561824224646*^9, 3.9035618389911203`*^9}, 
