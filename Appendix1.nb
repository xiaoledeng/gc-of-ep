Cell[TextData[{
 "1. (x\[CloseCurlyQuote], y\[CloseCurlyQuote], z\[CloseCurlyQuote]) are \
represented by (x3, y3, z3).\n2. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]\[Lambda]\[Lambda]", "s"], 
   TraditionalForm]],ExpressionUUID->"4c4876a7-ea51-41f1-8ac0-b9213c34676b"],
