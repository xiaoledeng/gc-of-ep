Cell[CellGroupData[{

Cell["1. Basic settings", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
  3.897354682168096*^9}},ExpressionUUID->"e62451a9-9db8-45da-84a0-\
faeee0715e70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "-", 
    RowBox[{"y3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}], "+", 
    RowBox[{"y3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"30cc2790-c8d4-4cf9-ac1d-7498cace19fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999588511198001*^9, 3.999588511198773*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"d1c02a41-02c1-43fc-8ca8-5c15c40ebbcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"x", "-", "x3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]y", "=", 
   RowBox[{"y", "-", "y3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]z", "=", 
   RowBox[{"z", "-", "z3"}]}], ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"b542f9c1-ebf3-4c4b-b2c0-ac466f7460b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "*", "\[CapitalDelta]x"}], 
    "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dy", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "-", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dz", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.904074018041793*^9, 3.904074022610565*^9}, {
  3.99958851119941*^9, 3.999588511201426*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"c98b5a0b-15a5-4d69-9546-fb441aa0824b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["r", "2"], "+", 
     SuperscriptBox["x3", "2"], "+", 
     SuperscriptBox["y3", "2"], "+", 
     SuperscriptBox["z3", "2"], "-", 
     RowBox[{"2", "*", "r", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z3", "*", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
        RowBox[{"B", "*", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.999588511202056*^9, 3.99958851120252*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8699e20c-c92f-48c3-8ce2-1459a8d32427"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. GV and GGT expressions in spherical integral kernels from Table B1\
\>", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
  3.897354682168096*^9}, {3.903560685939458*^9, 3.903560694981188*^9}, {
  3.903560748299528*^9, 3.903560767018676*^9}, {3.903562570720304*^9, 
  3.903562571174987*^9}, {3.903562674239479*^9, 3.903562677373361*^9}, {
  3.904074354275854*^9, 
  3.904074364241899*^9}},ExpressionUUID->"f55c69da-acb1-43ac-9a1c-\
21a5e2814209"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]", "=", 
   RowBox[{
    RowBox[{"-", "A"}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904074593437188*^9, 3.90407460339485*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"0eea048b-2ddc-41e1-8d3b-f8eea993d1ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z3", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"B", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904074666278822*^9, 3.904074690913765*^9}, {
  3.999588511203074*^9, 3.9995885112037773`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"ef869dbe-d3d2-408f-bc4a-ebffb6ae5e16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalVr", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"z3", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747005457478`*^9, 3.9040747314413443`*^9}, {
  3.9995885112043037`*^9, 3.999588511204668*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"43d63735-7811-4426-b765-8c690ded1768"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]\[Lambda]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       SuperscriptBox["r", "2"]}], "+", 
      SuperscriptBox["x3", "2"], "+", 
      SuperscriptBox["y3", "2"], "-", 
      RowBox[{"2", "*", 
       SuperscriptBox["z3", "2"]}], "-", 
      RowBox[{"3", "*", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x3", "2"], "-", 
         SuperscriptBox["y3", "2"]}], ")"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"6", "*", "x3", "*", "y3", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      SuperscriptBox["l", "5"]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073562209962*^9, 3.904073648768249*^9}, {
  3.999588511205327*^9, 3.999588511205834*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"b41ce8db-2108-4a0b-984c-bfbd051cd7b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]\[Phi]", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "*", "A", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z3", "-", 
       RowBox[{"B", "*", 
        RowBox[{"Tan", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
     SuperscriptBox["l", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747377737827`*^9, 3.904074767460651*^9}, {
  3.999588511206452*^9, 3.9995885112072153`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"c25af21b-2618-40c8-a57b-1bdc97bed50a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]r", "=", 
   RowBox[{"3", "*", "A", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"z3", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
     SuperscriptBox["l", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747746864*^9, 3.904074796409062*^9}, {
  3.9995885112077703`*^9, 3.999588511208199*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"4d28af37-e123-4a73-b185-e404fa44648b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]\[Phi]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["r", "2"]}], "-", 
      SuperscriptBox["x3", "2"], "-", 
      SuperscriptBox["y3", "2"], "-", 
      SuperscriptBox["z3", "2"], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["z3", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ")"}], "2"]}], "+", 
      RowBox[{"2", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"2", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"3", "*", "z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["B", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}], ")"}], "2"]}]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073661002722*^9, 3.9040737450885363`*^9}, {
  3.9995885112088413`*^9, 3.999588511211622*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"7ef32bbf-fb65-4452-9ef9-d0706a1fe1b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]r", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "*", 
    RowBox[{"(", 
     RowBox[{"r", "-", 
      RowBox[{"z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"z3", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
     SuperscriptBox["l", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904074804294921*^9, 3.904074831789345*^9}, {
  3.9995885112121572`*^9, 3.9995885112136106`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"969d3bde-e707-4cb6-851a-c6ebd362976b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalVrr", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "*", 
       SuperscriptBox["r", "2"]}], "-", 
      SuperscriptBox["x3", "2"], "-", 
      SuperscriptBox["y3", "2"], "-", 
      SuperscriptBox["z3", "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", "*", "r"}], "-", 
         RowBox[{"3", "*", "z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
         RowBox[{"3", "*", "B", "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
         RowBox[{"B", "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.90407375449382*^9, 3.904073808318606*^9}, {
  3.999588511214211*^9, 3.9995885112155027`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"8b43b1c2-d95a-4d32-94a6-169e77ce072e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3. GV and GGT expressions in Cartesian integral kernels from Table B2\
\>", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
