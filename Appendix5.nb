731035e17614"],

Cell[TextData[{
 "1. (x\[CloseCurlyQuote], y\[CloseCurlyQuote], z\[CloseCurlyQuote]) are \
represented by (x3, y3, z3).\n2. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]", "s"], TraditionalForm]],ExpressionUUID->
  "7356485b-691d-404d-8106-3afe2472c801"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Phi]", "s"], TraditionalForm]],ExpressionUUID->
  "b4965c0b-3938-42d2-a704-fb222efc016e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "r", "s"], TraditionalForm]],ExpressionUUID->
  "fa68f507-f921-4462-ae0a-bbf63bb0ff25"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]\[Lambda]", "s"], TraditionalForm]],
  ExpressionUUID->"7db004ed-aa0d-4a10-932f-4ac35776ee3a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]\[Phi]", "s"], TraditionalForm]],
  ExpressionUUID->"b0c3354c-9415-4685-9776-33a6a966002c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]r", "s"], TraditionalForm]],
  ExpressionUUID->"64a02778-1c5a-48f4-b0ef-ce60989fbf76"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Phi]\[Phi]", "s"], TraditionalForm]],
  ExpressionUUID->"71956cf1-fa9c-4c89-9dc0-2d5cc2e6b255"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Phi]r", "s"], TraditionalForm]],ExpressionUUID->
  "871184e1-a43e-4eb1-89cf-587fa3b2844f"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "rr", "s"], TraditionalForm]],ExpressionUUID->
  "9194c361-6b3c-40e5-8525-41b485001d63"],
 " in Table B1  are represented by SphericalV\[Lambda], SphericalV\[Phi], \
SphericalVr, SphericalV\[Lambda]\[Lambda], SphericalV\[Lambda]\[Phi], \
SphericalV\[Lambda]r, SphericalV\[Phi]\[Phi], SphericalV\[Phi]r, and \
SphericalVrr. \n3. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "x", "c"], TraditionalForm]],ExpressionUUID->
  "4b7d5ff3-b341-458e-a601-c40f59f702c8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "y", "c"], TraditionalForm]],ExpressionUUID->
  "8d225fbc-12d9-4343-8d72-dba6cc6a2cb1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "z", "c"], TraditionalForm]],ExpressionUUID->
  "67bf96d0-0c01-42d2-a6aa-5eaab32f0175"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xx", "c"], TraditionalForm]],ExpressionUUID->
  "e4ddc0d3-c31d-45e6-bde0-f50458cdf617"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xy", "c"], TraditionalForm]],ExpressionUUID->
  "ca90cac4-aee9-4d2c-9c71-9fd46cf98811"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xz", "c"], TraditionalForm]],ExpressionUUID->
  "5f1ba7ab-d061-42b1-a91c-6d15667f437e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yy", "c"], TraditionalForm]],ExpressionUUID->
  "a11d0fa8-f17d-4615-83cc-44d590e5417f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yz", "c"], TraditionalForm]],ExpressionUUID->
  "3b409648-7200-4fcd-896b-afc236c40b99"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zz", "c"], TraditionalForm]],ExpressionUUID->
  "947c913d-eaaa-4297-ba05-bd2f4bac9f91"],
 " in Table B2 are represented by CartesianVx, CartesianVy, CartesianVz, \
CartesianVxx, CartesianVxy, CartesianVxz, CartesianVyy, CartesianVyz, and \
CartesianVzz.\n4. The integral kernels are considered and the complete \
expressions should be presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G\[Rho]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[Lambda]", "1"], 
      SubscriptBox["\[Lambda]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[CurlyPhi]", "1"], 
       SubscriptBox["\[CurlyPhi]", "2"]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["u", "1"], 
        SubscriptBox["u", "2"]], 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", "Kernel", ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"u", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[CurlyPhi]", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[Lambda]", "'"}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"cb64eb2e-eea8-4cc1-88c6-6cf7fa71262e"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9035606025437403`*^9, 3.903560667511909*^9}, {
