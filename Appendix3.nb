  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}], "+", 
    RowBox[{"y3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"9ac949d3-ae95-4b9c-a656-5735a0475b87"],

