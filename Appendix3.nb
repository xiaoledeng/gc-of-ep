 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"x", "-", "x3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]y", "=", 
   RowBox[{"y", "-", "y3"}]}], ";"}], "\[IndentingNewLine]", 
