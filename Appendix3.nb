    RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
