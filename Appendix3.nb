Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "*", "\[CapitalDelta]x"}], 
