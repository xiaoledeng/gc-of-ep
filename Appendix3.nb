  FormBox[
   SubsuperscriptBox["V", "yyy", "c"], TraditionalForm]],ExpressionUUID->
  "259f294e-eab5-4b4e-a6a7-58bd3a920085"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yyz", "c"], TraditionalForm]],ExpressionUUID->
  "330e6e45-5cd8-42fa-8c0b-5c6fbd1403fa"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzx", "c"], TraditionalForm]],ExpressionUUID->
  "ae4e63de-bbb8-499c-83ca-29efa855b0cc"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzy", "c"], TraditionalForm]],ExpressionUUID->
  "e46ce323-d43b-40ec-a94f-8ead750bfdee"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zzz", "c"], TraditionalForm]],ExpressionUUID->
  "860b69c6-c4ef-4d47-80d3-43f01ab38e09"],
 " in Table 3 are represented by CartesianVxxx, CartesianVxxy, CartesianVxxz, \
CartesianVxyz, CartesianVyyx, CartesianVyyy, CartesianVyyz, CartesianVzzx, \
CartesianVzzy, and CartesianVzzz.\n4. The integral kernels are considered and \
the complete expressions should be presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G\[Rho]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[Lambda]", "1"], 
      SubscriptBox["\[Lambda]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[CurlyPhi]", "1"], 
       SubscriptBox["\[CurlyPhi]", "2"]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["u", "1"], 
        SubscriptBox["u", "2"]], 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", "Kernel", ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"u", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[CurlyPhi]", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[Lambda]", "'"}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"393ad0e9-c813-4153-b590-dd2a3a9a82ef"],
 ". "
}], "Text",
