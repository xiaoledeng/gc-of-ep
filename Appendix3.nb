   SubsuperscriptBox["V", "xyz", "c"], TraditionalForm]],ExpressionUUID->
  "aedaeebc-330f-4e9f-a240-c4b63461272e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yyx", "c"], TraditionalForm]],ExpressionUUID->
  "8d36b8cd-57b0-48b5-b99d-4d94deb587c1"],
 ", ",
