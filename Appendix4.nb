Cell[CellGroupData[{

Cell["0. Readme", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
  3.897354682168096*^9}, {3.9035604576288652`*^9, 
  3.9035604624525023`*^9}},ExpressionUUID->"857aeff0-95a7-444c-a64a-\
df36707371b6"],

Cell[TextData[{
 "1. (x\[CloseCurlyQuote], y\[CloseCurlyQuote], z\[CloseCurlyQuote]) are \
represented by (x3, y3, z3).\n2. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Lambda]\[Lambda]", "s"], TraditionalForm]],
  ExpressionUUID->"ee1b48b2-5b69-48b7-9181-7e7bf6f942ff"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "\[Phi]\[Phi]", "s"], TraditionalForm]],
  ExpressionUUID->"38d80f40-1e67-4b1e-a23f-1779bbd08a8e"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "rr", "s"], TraditionalForm]],ExpressionUUID->
  "7ebda024-4fc4-4902-b6dd-1d3531630be0"],
 " in Table B1 and Eq. (B3)  are represented by SphericalV\[Lambda]\[Lambda], \
SphericalV\[Phi]\[Phi], and SphericalVrr. \n3. ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "xx", "c"], TraditionalForm]],ExpressionUUID->
  "17258465-27fa-4045-8d3a-e6cef3e896a4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "yy", "c"], TraditionalForm]],ExpressionUUID->
  "58b44ad2-5892-47f6-8c30-50821973b9b4"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["V", "zz", "c"], TraditionalForm]],ExpressionUUID->
  "d4cd6c68-52d9-4ce2-8c40-c6486d1b3ba0"],
 " in Table B2 and Eq. (B4)  are represented by CartesianVxx, CartesianVyy, \
and CartesianVzz.\n4. The integral kernels are considered and the complete \
expressions should be presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G\[Rho]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[Lambda]", "1"], 
      SubscriptBox["\[Lambda]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[CurlyPhi]", "1"], 
       SubscriptBox["\[CurlyPhi]", "2"]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["u", "1"], 
        SubscriptBox["u", "2"]], 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", "Kernel", ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"u", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[CurlyPhi]", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[Lambda]", "'"}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"a4dc54d2-4cf4-4870-806e-687cc3c022d4"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9035606025437403`*^9, 3.903560667511909*^9}, {
  3.9035608186325083`*^9, 3.903561082403344*^9}, {3.903561128828815*^9, 
  3.903561129119686*^9}, {3.903647863546836*^9, 3.9036479138260593`*^9}, {
  3.90364798244635*^9, 3.903648099503888*^9}, {3.904073203083029*^9, 
