Cell[BoxData[
 RowBox[{
  RowBox[{"CartesianVyy", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox["dy", "2"]}], "-", 
      SuperscriptBox["l", "2"]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040735245851192`*^9, 3.9040735255378933`*^9}, {
  3.904073840294351*^9, 3.904073852842689*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"5b469910-a609-4644-8c0a-c5e2cc314a8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CartesianVzz", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox["dz", "2"]}], "-", 
      SuperscriptBox["l", "2"]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073532691785*^9, 3.9040735332204523`*^9}, {
