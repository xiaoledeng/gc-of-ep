20a2f5e905a4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Basic settings", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
  3.897354682168096*^9}},ExpressionUUID->"0d56aa3d-9d35-478f-b9d9-\
6edff9782efe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "-", 
    RowBox[{"y3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}], "+", 
    RowBox[{"y3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"fa8a1d44-40d3-4fa2-a235-327e66d35601"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["r", "2"], "+", 
     SuperscriptBox["x3", "2"], "+", 
     SuperscriptBox["y3", "2"], "+", 
     SuperscriptBox["z3", "2"], "-", 
     RowBox[{"2", "*", "r", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z3", "*", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
        RowBox[{"B", "*", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.903561824224646*^9, 3.9035618389911203`*^9}, 
   3.9035619115323343`*^9, 3.90407336160877*^9, {3.9995884912429256`*^9, 
   3.999588491243572*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"8f29280f-c2b8-47a1-9eec-67a7115339ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"r", "*", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.90356180725404*^9, {3.9995884912443743`*^9, 3.999588491245523*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"fc19aa63-d23d-4ebd-993f-3c66724fed81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"x", "-", "x3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]y", "=", 
   RowBox[{"y", "-", "y3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]z", "=", 
   RowBox[{"z", "-", "z3"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.903561814716457*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"19b5e7c4-a520-4961-9045-5b0cee286929"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "*", "\[CapitalDelta]x"}], 
    "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dy", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "-", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dz", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]x"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}], "*", "\[CapitalDelta]y"}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", "\[CapitalDelta]z"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.904074089554099*^9, 3.904074093731965*^9}, {
  3.999588491246323*^9, 3.999588491248702*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"b60963b2-0c35-41c1-8679-3f2086fdc178"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Expressions from Table B1 involved in Eq. (B3)", "Subsection",
 CellChangeTimes->{{3.895915958726475*^9, 3.8959159951551723`*^9}, {
  3.896172780131712*^9, 3.896172782505323*^9}, {3.8973546767144527`*^9, 
  3.897354682168096*^9}, {3.903560685939458*^9, 3.903560694981188*^9}, {
  3.903560748299528*^9, 3.903560767018676*^9}, {3.904073386284519*^9, 
  3.9040733935988207`*^9}},ExpressionUUID->"34fe700a-840e-4508-8bd6-\
0ad4515d2096"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]\[Lambda]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       SuperscriptBox["r", "2"]}], "+", 
      SuperscriptBox["x3", "2"], "+", 
      SuperscriptBox["y3", "2"], "-", 
      RowBox[{"2", "*", 
       SuperscriptBox["z3", "2"]}], "-", 
      RowBox[{"3", "*", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x3", "2"], "-", 
         SuperscriptBox["y3", "2"]}], ")"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"6", "*", "x3", "*", "y3", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      SuperscriptBox["l", "5"]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073562209962*^9, 3.904073648768249*^9}, {
  3.999588491249505*^9, 3.999588491250079*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"17da9e06-aded-4de6-bccc-4d5c6e5f24f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]\[Phi]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["r", "2"]}], "-", 
      SuperscriptBox["x3", "2"], "-", 
      SuperscriptBox["y3", "2"], "-", 
      SuperscriptBox["z3", "2"], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["z3", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ")"}], "2"]}], "+", 
      RowBox[{"2", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"2", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"3", "*", "z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["B", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}], ")"}], "2"]}]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073661002722*^9, 3.9040737450885363`*^9}, {
  3.999588491250853*^9, 3.999588491254208*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"b7006714-b9f8-4971-b6d9-5092677c02fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalVrr", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "*", 
       SuperscriptBox["r", "2"]}], "-", 
      SuperscriptBox["x3", "2"], "-", 
      SuperscriptBox["y3", "2"], "-", 
      SuperscriptBox["z3", "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", "*", "r"}], "-", 
         RowBox[{"3", "*", "z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
         RowBox[{"3", "*", "B", "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
         RowBox[{"B", "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.90407375449382*^9, 3.904073808318606*^9}, {
  3.999588491254951*^9, 3.999588491256516*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"76dfc5aa-8044-41c9-a238-4033a238efc4"]
}, Open  ]],

