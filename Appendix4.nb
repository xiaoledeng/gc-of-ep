Cell[BoxData[
 RowBox[{
  RowBox[{"CartesianVxx", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox["dx", "2"]}], "-", 
      SuperscriptBox["l", "2"]}], ")"}], "/", 
