  FormBox[
   SubscriptBox["\[CapitalDelta]Z", "PS"], TraditionalForm]],ExpressionUUID->
  "30518659-dbe6-4c28-b7c8-e2b27a6e47ec"],
 ") \[RightArrow] (\[CapitalDelta]x, \[CapitalDelta]y, \[CapitalDelta]z)\n\t\
\[FilledSquare] (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "P"], TraditionalForm]],ExpressionUUID->
  "8ddf8b79-0dde-4230-808b-9c53aa97edd3"],
 ", ",
