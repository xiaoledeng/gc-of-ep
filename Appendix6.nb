 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "P"], TraditionalForm]],ExpressionUUID->
  "31b08c34-d21e-4366-a459-800b8c19836a"],
 ") \[RightArrow] (\[Lambda], \[Phi], r) \n\t\[FilledSquare] PS \[RightArrow] \
l\n4. The integral kernels are considered and the complete expressions should \
be presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G\[Rho]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[Lambda]", "1"], 
      SubscriptBox["\[Lambda]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[CurlyPhi]", "1"], 
       SubscriptBox["\[CurlyPhi]", "2"]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["u", "1"], 
        SubscriptBox["u", "2"]], 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", "Kernel", ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"u", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[CurlyPhi]", "'"}]}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"\[Lambda]", "'"}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"fee12e8a-6f2c-43d3-aad5-5710d2181568"],
 "(i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     SubscriptBox["\[Lambda]", "1"], 
     SubscriptBox["\[Lambda]", "2"]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["\[CurlyPhi]", "1"], 
      SubscriptBox["\[CurlyPhi]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["u", "1"], 
       SubscriptBox["u", "2"]], 
      RowBox[{"G", " ", 
       SubscriptBox["\[Rho]", "S"], " ", 
       RowBox[{"(", "Kernel", ")"}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["\[CapitalOmega]", "S"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9faddc7a-4217-4d8e-9af4-7fe1226798a6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DifferentialD]", 
    SubscriptBox["\[CapitalOmega]", "S"]}], TraditionalForm]],ExpressionUUID->
  "384c0242-e0ee-404d-b2b4-72bfe1f86a03"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["N", "S", "3"], "cos", " ", 
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "S"], "(", 
     RowBox[{"1", "-", 
      SuperscriptBox["e", "2"]}], ")"}], 
    SuperscriptBox["u", "2"], 
    RowBox[{"\[DifferentialD]", "\[Lambda]"}], 
    RowBox[{"\[DifferentialD]", "\[CurlyPhi]"}], " ", 
    RowBox[{"\[DifferentialD]", "u", " "}]}], TraditionalForm]],
  ExpressionUUID->"a828b466-d85c-4dda-8391-33b6fa6c0c60"],
 " is represented by \[Kappa] \[DifferentialD]u\[CloseCurlyQuote]\
\[DifferentialD]\[CurlyPhi]\[CloseCurlyQuote]\[DifferentialD]\[Lambda]\
\[CloseCurlyQuote] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["N", "3"], "cos", " ", 
    RowBox[{"\[CurlyPhi]", "'"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["e", "2"]}], ")"}], 
    SuperscriptBox[
     RowBox[{"u", "'"}], "2"]}], TraditionalForm]],ExpressionUUID->
  "335dd7c7-42f6-458b-a703-e1da608d2b0c"],
 "\[DifferentialD]u\[CloseCurlyQuote]\[DifferentialD]\[CurlyPhi]\
\[CloseCurlyQuote]\[DifferentialD]\[Lambda]\[CloseCurlyQuote] . "
}], "Text",
