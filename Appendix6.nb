81a6f42b1a35"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}], "-", 
    RowBox[{"y3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{
    RowBox[{"x3", "*", 
     RowBox[{"Cos", "[", "\[Lambda]", "]"}]}], "+", 
    RowBox[{"y3", "*", 
     RowBox[{"Sin", "[", "\[Lambda]", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"fb54cce1-9dfc-4602-9194-859b89e656fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["r", "2"], "+", 
     SuperscriptBox["x3", "2"], "+", 
     SuperscriptBox["y3", "2"], "+", 
     SuperscriptBox["z3", "2"], "-", 
     RowBox[{"2", "*", "r", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z3", "*", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
        RowBox[{"B", "*", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}]]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.999588531134324*^9, 3.999588531134761*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"4c8f5b04-4d3e-42e3-8329-fcb17eed647f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]", "=", 
   RowBox[{
    RowBox[{"-", "A"}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904074593437188*^9, 3.90407460339485*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e3f48ef6-16bd-4b4a-aaed-1331ec6862d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z3", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"B", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904074666278822*^9, 3.904074690913765*^9}, {
  3.999588531135276*^9, 3.999588531135948*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"ee358f94-5b38-4e13-bba6-61d378dc3e09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalVr", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"z3", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}], "/", 
    SuperscriptBox["l", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747005457478`*^9, 3.9040747314413443`*^9}, {
  3.999588531136479*^9, 3.999588531136861*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"3ad2011e-8a13-42e2-bde4-cac1633d28b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]\[Lambda]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       SuperscriptBox["r", "2"]}], "+", 
      SuperscriptBox["x3", "2"], "+", 
      SuperscriptBox["y3", "2"], "-", 
      RowBox[{"2", "*", 
       SuperscriptBox["z3", "2"]}], "-", 
      RowBox[{"3", "*", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x3", "2"], "-", 
         SuperscriptBox["y3", "2"]}], ")"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"4", "*", "r", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"6", "*", "x3", "*", "y3", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "*", "\[Lambda]"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      SuperscriptBox["l", "5"]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073562209962*^9, 3.904073648768249*^9}, {
  3.999588531137548*^9, 3.999588531138035*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"01e8e322-231d-4290-9cec-25b37208e39a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]\[Phi]", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "*", "A", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z3", "-", 
       RowBox[{"B", "*", 
        RowBox[{"Tan", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
     SuperscriptBox["l", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747377737827`*^9, 3.904074767460651*^9}, {
  3.9995885311385736`*^9, 3.99958853113929*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"7cdbd817-be7a-486b-8309-68fd854c33db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Lambda]r", "=", 
   RowBox[{"3", "*", "A", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"z3", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "/", 
     SuperscriptBox["l", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9040747746864*^9, 3.904074796409062*^9}, {
  3.9995885311397943`*^9, 3.9995885311401377`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"168bff05-6613-4560-a441-c5b6d168d973"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]\[Phi]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["r", "2"]}], "-", 
      SuperscriptBox["x3", "2"], "-", 
      SuperscriptBox["y3", "2"], "-", 
      SuperscriptBox["z3", "2"], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["z3", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ")"}], "2"]}], "+", 
      RowBox[{"2", "*", "r", "*", "z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
      RowBox[{"2", "*", "B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"3", "*", "z3", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["B", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}], ")"}], "2"]}]}], ")"}], "/", 
    SuperscriptBox["l", "5"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.904073661002722*^9, 3.9040737450885363`*^9}, {
  3.999588531140726*^9, 3.9995885311435966`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"f7fa4714-ded2-4a1b-8ba8-1642098a3b50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalV\[Phi]r", "=", 
   RowBox[{
    RowBox[{"-", "3"}], "*", 
    RowBox[{"(", 
     RowBox[{"r", "-", 
      RowBox[{"z3", "*", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", 
      RowBox[{"B", "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"z3", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
       RowBox[{"B", "*", 
